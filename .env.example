# Copy to .env at the repository root. Values shown are application defaults.
# Production detection remains tied to backend/models/best.pt and its nine IDs.
# Blank secrets use generated/persisted local development values.
SECRET_KEY=
JWT_SECRET_KEY=
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=crime_evidence_db
DB_NAME=crime_evidence_db
MONGO_SERVER_SELECTION_TIMEOUT_MS=1000
MONGO_SOCKET_TIMEOUT_MS=10000
UPLOAD_FOLDER=uploads

YOLO_MODEL_PATH=models/best.pt
YOLO_IMAGE_SIZE=832
YOLO_CONFIDENCE=0.25
CNN_MODEL_PATH=models/best_cnn.pth
CNN_IMAGE_SIZE=224
CNN_MEAN=0.485,0.456,0.406
CNN_STD=0.229,0.224,0.225
CNN_CONFIDENCE=0.0
CNN_PREPROCESSING_SOURCE="config_default; verify against training transforms"
ANOMALY_MODEL_PATH=models/bigru_mil_best.pt
VIDEO_ANOMALY_MODEL_PATH=models/video_anomaly_autoencoder.pth
VIDEO_ANOMALY_CONFIG_PATH=models/video_anomaly_config.json
VIDEO_ANOMALY_MAX_GAP_SEC=3

# Docker Compose uses Windows host routing. For native Flask, set this to 127.0.0.1.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
OLLAMA_HEALTH_TIMEOUT=4
OLLAMA_CHAT_TIMEOUT=120

# Video sampling, duration, and tracking
VIDEO_SAMPLE_FPS=1
VIDEO_SAMPLE_INTERVAL=0
VIDEO_MAX_PROCESSED_FRAMES=300
VIDEO_MAX_SAMPLED_FRAMES=300
VIDEO_MAX_DURATION_SEC=600
VIDEO_TRACKING_ENABLED=true
VIDEO_TRACKER=bytetrack.yaml
VIDEO_CONFIDENCE_THRESHOLD=0.25

# Scene-change candidates and optional whole-video classifier
VIDEO_SCENE_CHANGE_ENABLED=true
VIDEO_SCENE_CHANGE_SSIM_THRESHOLD=0.55
VIDEO_SCENE_CHANGE_DIFF_RATIO=0.30
VIDEO_MODEL_PATH=models/video_classifier.pth
# Experimental opt-in; defaults to the existing production classifier.
VIDEO_CLASSIFIER_BACKEND=legacy
VIDEO_DENSENET_MODEL_PATH=training/densenet_attention_convlstm_run01/best_checkpoint.pth
# Candidate opt-in (original remains the default until evaluation supports promotion):
# VIDEO_MODEL_PATH=models/video_classifier_v2.pth
# Repo-root form is also supported: VIDEO_MODEL_PATH=backend/models/video_classifier_v2.pth
CLASS_NAMES_PATH=models/class_names.json
VIDEO_MIN_CONFIDENCE=0.0
R3D18_MAX_DURATION_SEC=600

# Event grouping
VIDEO_EVENT_MAX_GAP_SEC=3
VIDEO_EVENT_MIN_OBSERVATIONS=1

# Docker read-only dataset bind source. Set this to the existing host dataset;
# no source videos are copied into this project.
SOURCE_DATASET_PATH=C:/Users/admin/OneDrive/Documents/crime_video_dataset
# Native backend catalog source. Docker sets EVIDENCE_SOURCE_DIR=/data/source-videos.
EVIDENCE_SOURCE_DIR=C:/Users/admin/OneDrive/Documents/crime_video_dataset
ASSAULT_RESULTS_DIR=backend/tracked_results_400/Assault
ROBBERY_RESULTS_DIR=backend/tracked_results_400/Robbery
ROBBERY_TRACKING_STATUS_PATH=backend/tracked_results_400/Robbery/tracking_status.csv
SHOOTING_RESULTS_DIR=backend/tracked_results_shooting_import/main_archive/Shooting/detections
NORMAL_RESULTS_DIR=backend/tracked_results_400/Normal
SHOOTING_TRACKING_STATUS_PATH=backend/tracked_results_shooting_import/main_archive/Shooting/shooting_tracking_status.csv
ASSAULT_TRACKING_STATUS_PATH=backend/tracked_results_400/Assault/tracking_status.csv
ASSAULT_LEGACY_JSON_PATH=backend/assault_77_video_detections.json
VIDEO_EVENT_MIN_IOU=0.1

# Temporal event timestamp refinement. Defaults are uncalibrated review aids;
# calibrate category weights against verified reference intervals before use.
TEMPORAL_EVENT_BIN_SEC=1.0
TEMPORAL_EVENT_MIN_SCORE=0.55
TEMPORAL_EVENT_MIN_CLASSIFIER_PROBABILITY=0.5
TEMPORAL_EVENT_MIN_SUPPORTED_BINS=1
TEMPORAL_EVENT_MAX_TRACK_GAP_SEC=2.0
TEMPORAL_EVENT_BOUNDARY_TOLERANCE_SEC=0.0
TEMPORAL_EVENT_YOLO_PERSISTENCE_OBSERVATIONS=2
# Optional JSON: {"shooting":{"classifier":0.7,"yolo":0.15,"tracking":0.15}, ...}
TEMPORAL_EVENT_WEIGHTS=

# Motion sampling, blur filtering, and low-light preprocessing
VIDEO_MOTION_DIFF_THRESHOLD=18.0
VIDEO_MOTION_RATIO_THRESHOLD=0.025
VIDEO_MOTION_MAX_FPS=5.0
VIDEO_MIN_LAPLACIAN_VARIANCE=8.0
VIDEO_CLAHE_ENABLED=true

# Optional person-region pass is disabled by default because it can add
# false positives. Enable only for controlled experimentation.
VIDEO_PERSON_ROI_ENABLED=false
VIDEO_PERSON_ROI_MAX=2
VIDEO_ROI_CONFIDENCE=0.25
VIDEO_ROI_IMAGE_SIZE=640

# Per-class confidence thresholds for IDs 0-8 in the production checkpoint.
VIDEO_CLASS_CONFIDENCE_GUN=0.30
VIDEO_CLASS_CONFIDENCE_HAMMER=0.25
VIDEO_CLASS_CONFIDENCE_HELMET=0.25
VIDEO_CLASS_CONFIDENCE_KNIFE=0.25
VIDEO_CLASS_CONFIDENCE_MASK=0.25
VIDEO_CLASS_CONFIDENCE_PERSON=0.25
VIDEO_CLASS_CONFIDENCE_PISTOL=0.25
VIDEO_CLASS_CONFIDENCE_RIFLE=0.25
VIDEO_CLASS_CONFIDENCE_WEAPON=0.25

# Uncalibrated investigative-prioritization rubric (not a crime probability).
# Thresholds and point ceilings are policy settings, not learned metrics.
RISK_THRESHOLD_MODERATE=25
RISK_THRESHOLD_HIGH=50
RISK_THRESHOLD_CRITICAL=75
RISK_ACTIVITY_ASSAULT_SEVERITY=35
RISK_ACTIVITY_ROBBERY_SEVERITY=40
RISK_ACTIVITY_SHOOTING_SEVERITY=50
RISK_OBJECT_WEAPON_SEVERITY=18
RISK_OBJECT_BLOOD_SEVERITY=12
RISK_CONSISTENT_TRACKING_POINTS=5
RISK_INDEPENDENT_CORROBORATION_POINTS=10
RISK_ADDITIONAL_EVENT_POINTS=3
RISK_DURATION_MAX_POINTS=5
RISK_EVENT_DURATION_CAP_SEC=10
